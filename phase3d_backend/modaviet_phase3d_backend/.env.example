PORT=8080
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/modaviet_kho
DB_POOL_MAX=10
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
ALLOWED_GOOGLE_DOMAIN=modaviet.vn
AUTH_BYPASS_FOR_LOCAL=false
PERFORMANCE_TARGET_P95_MS=1500

# Cloud SQL option (used when DATABASE_URL is empty)
DB_USER=modaviet_app
DB_PASSWORD=CHANGE_ME
DB_NAME=modaviet_kho
INSTANCE_CONNECTION_NAME=PROJECT:asia-southeast1:modaviet-kho-npl-v2-pilot
